---
- name: Mass distribution of administrative notifications to desktops
  hosts: message_targets
  gather_facts: false
  become: false

  tasks:
    - name: "========================================================================="
      ansible.builtin.debug:
        msg: " ОТПРАВКА СООБЩЕНИЯ НА КОМПЬЮТЕР: {{ inventory_hostname }} "

    - name: СОХРАНЕНИЕ ТЕКСТА | Запись сообщения в изолированный файл на удаленном ПК
      ansible.builtin.copy:
        content: "{% raw %}{{ msg_text }}{% endraw %}"
        dest: /tmp/msg_content.txt
        mode: '0644'

    - name: ГЕНЕРАЦИЯ И ЗАПУСК ОКНА | Вывод PyQt5 окна с чтением из файла
      ansible.builtin.shell: |
        cat << 'EOF' > /tmp/send_gui_msg.py
        import sys
        import os
        from PyQt5.QtWidgets import QApplication, QMessageBox, QPushButton, QSpacerItem, QSizePolicy, QLabel
        from PyQt5.QtCore import QTimer, Qt
        from PyQt5.QtGui import QFont

        app = QApplication(sys.argv)
        
        msg = QMessageBox()
        msg.setIcon(QMessageBox.Information)
        msg.setWindowTitle("{% raw %}{{ msg_title }}{% endraw %}")
        
        # БЕЗОПАСНОЕ ЧТЕНИЕ: Скрипт просто читает чистый текст с диска, 
        # ему больше плевать на любые кавычки внутри сообщения!
        raw_text = ""
        if os.path.exists("/tmp/msg_content.txt"):
            with open("/tmp/msg_content.txt", "r", encoding="utf-8") as f:
                raw_text = f.read()

        font = QFont("Segoe UI", 13)
        msg.setFont(font)

        # Обертываем прочитанный текст в HTML для идеального левого выравнивания
        html_text = f'<div style="width: 440px; white-space: pre-wrap; word-wrap: break-word;">{raw_text}</div>'
        msg.setText(html_text)

        # Фиксируем общую длину каркаса окна ровно на 600 пикселей
        layout = msg.layout()
        horizontal_spacer = QSpacerItem(600, 0, QSizePolicy.Fixed, QSizePolicy.Expanding)
        layout.addItem(horizontal_spacer, layout.rowCount(), 0, 1, layout.columnCount())

        # Адаптивное добавление строк для удержания минимального размера
        lines_count = raw_text.count('\n') + (len(raw_text) // 45)
        needed_newlines = max(0, 5 - lines_count)
        if needed_newlines > 0:
            msg.setText(html_text + ("<br>" * needed_newlines))

        # Полностью блокируем крестик закрытия и верхнее меню ИБ
        msg.setWindowFlags(msg.windowFlags() | Qt.WindowStaysOnTopHint | Qt.CustomizeWindowHint)
        msg.setWindowFlags(msg.windowFlags() & ~Qt.WindowCloseButtonHint)

        ok_button = msg.addButton(QMessageBox.Ok)
        
        ok_button.setMinimumWidth(160)
        ok_button.setMinimumHeight(38)
        
        timeout = {% raw %}{{ msg_timeout }}{% endraw %}

        if timeout > 0:
            ok_button.setEnabled(False)
            ok_button.setText(f"ОК ({timeout} сек.)")

            def update_timer():
                global timeout
                timeout -= 1
                if timeout > 0:
                    ok_button.setText(f"ОК ({timeout} сек.)")
                else:
                    timer.stop()
                    ok_button.setText("ОК")
                    ok_button.setEnabled(True)

            timer = QTimer()
            timer.timeout.connect(update_timer)
            timer.start(1000)

        msg.show()
        sys.exit(app.exec_())
        EOF

        DISPLAY=:0 python3 /tmp/send_gui_msg.py &
      async: 10
      poll: 0

    - name: "-------------------------------------------------------------------------"
      ansible.builtin.debug:
        msg: " УВЕДОМЛЕНИЕ УСПЕШНО ОТПРАВЛЕНО НА: {{ inventory_hostname }} "
